{
  "name": "finnix-film-port",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:rls": "vitest run tests/rls",
    "test:e2e": "playwright test --project=functional",
    "test:e2e:visual": "npm run db:reset && playwright test --project=visual",
    "test:e2e:update-snapshots": "npm run db:reset && playwright test --project=visual --update-snapshots",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:integration && npm run test:rls && npm run test:e2e && npm run test:e2e:visual",
    "db:seed": "tsx supabase/seed.ts",
    "db:reset": "supabase db reset && sleep 6 && npm run db:seed"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "chart.js": "^4.5.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
